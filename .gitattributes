# Normalize line endings to LF in the repository and on checkout, on every platform.
* text=auto eol=lf

# Leave development files out of the archives Composer downloads for a release.
/.gitattributes export-ignore
/.gitignore     export-ignore
/composer.lock  export-ignore
/phpcs.xml      export-ignore
/phpstan.neon   export-ignore
/phpunit.xml    export-ignore
/scripts        export-ignore
/tests          export-ignore
